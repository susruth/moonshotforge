---
import { applyPrograms } from '../data';
---

<section id="apply" class="relative z-[1] bg-forge-dim2 px-5 py-20 sm:px-8 sm:py-24 lg:px-[60px] lg:py-[120px]">
  <div class="section-label fade-up">09 · Apply</div>
  <h2 class="fade-up font-syne font-bold tracking-[-0.02em] leading-[1.05]
             text-[30px] sm:text-[38px] lg:text-[48px] xl:text-[54px] mb-4">
    Work With Us
  </h2>
  <p class="fade-up text-[13px] leading-[1.9] text-forge-cream max-w-[520px] mb-14">
    We partner with founders building the infrastructure and applications that will
    power the next wave of decentralized technology.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-[2px]">
    {applyPrograms.map((p, i) => (
      <button
        class="apply-card bg-forge-black border border-subtle p-8 sm:p-10 text-left cursor-pointer
               transition-all duration-300 hover:border-[rgba(232,213,163,0.22)]
               fade-up w-full"
        style={`transition-delay: ${i * 0.1}s`}
        data-apply={p.type}
        aria-label={`Apply to ${p.title}`}
      >
        <div class="text-[28px] mb-4">{p.icon}</div>
        <div class="font-syne font-bold text-[20px] sm:text-[22px] mb-2">{p.title}</div>
        <p class="text-[12px] leading-[1.8] text-[rgba(200,195,184,0.55)] mb-6">{p.desc}</p>
        <div class="border-t border-subtle pt-5">
          {p.details.map(d => (
            <div class="flex justify-between items-center py-1.5 border-b border-[rgba(240,237,230,0.04)] last:border-b-0">
              <span class="text-[10px] tracking-wider2 uppercase text-[rgba(200,195,184,0.35)]">{d.key}</span>
              <span class="text-[12px] text-forge-cream">{d.val}</span>
            </div>
          ))}
        </div>
      </button>
    ))}
  </div>
</section>

<style>
  .section-label {
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #e8d5a3;
    margin-bottom: 48px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .section-label::after {
    content: '';
    flex: 1;
    max-width: 60px;
    height: 1px;
    background: var(--border);
  }
</style>
