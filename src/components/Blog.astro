---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
// Sort by date descending (newest first)
const sortedPosts = posts.sort((a, b) => {
  const months: Record<string, number> = { Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5, Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11 };
  const [aMonth, aYear] = a.data.date.split(' ');
  const [bMonth, bYear] = b.data.date.split(' ');
  const aDate = new Date(parseInt(aYear), months[aMonth] || 0);
  const bDate = new Date(parseInt(bYear), months[bMonth] || 0);
  return bDate.getTime() - aDate.getTime();
});
---

<section id="blog" class="relative z-[1] bg-forge-dim2 px-5 py-20 sm:px-8 sm:py-24 lg:px-[60px] lg:py-[120px]">
  <div class="section-label fade-up">07 · Blog</div>
  <h2 class="fade-up font-syne font-bold tracking-[-0.02em] leading-[1.05] mb-14
             text-[30px] sm:text-[38px] lg:text-[48px] xl:text-[54px]">
    From The Forge
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[2px]">
    {sortedPosts.map((post, i) => (
      <a
        href={`/blog/${post.slug}`}
        class="blog-card bg-forge-black border border-subtle overflow-hidden text-left
               cursor-pointer transition-all duration-300 hover:border-[rgba(232,213,163,0.2)]
               fade-up block no-underline text-forge-white"
        style={`transition-delay: ${i * 0.1}s`}
      >
        <!-- Blog image -->
        <div class="relative aspect-[16/9] overflow-hidden">
          <img src={post.data.image} alt={post.data.imageAlt || post.data.title}
               class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-forge-black/60 to-transparent"></div>
        </div>
        <!-- Content -->
        <div class="p-6 sm:p-7">
          <div class="flex gap-2.5 items-center mb-3 flex-wrap">
            <span class="text-[9px] tracking-wider3 uppercase text-forge-accent
                         border border-[rgba(232,213,163,0.25)] px-2 py-1">
              {post.data.category}
            </span>
            <span class="text-[10px] text-[rgba(200,195,184,0.35)] tracking-[0.1em]">{post.data.date}</span>
          </div>
          <div class="font-syne font-bold text-[17px] leading-[1.25] mb-2.5 tracking-[-0.01em]">
            {post.data.title}
          </div>
          <p class="text-[11px] leading-[1.75] text-[rgba(200,195,184,0.5)] mb-4">
            {post.data.excerpt}
          </p>
          <span class="blog-arrow flex items-center gap-1.5 text-[10px] tracking-[0.16em] uppercase
                       text-forge-accent transition-all duration-200">
            Read article →
          </span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .section-label {
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #e8d5a3;
    margin-bottom: 48px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .section-label::after {
    content: '';
    flex: 1;
    max-width: 60px;
    height: 1px;
    background: var(--border);
  }
</style>
