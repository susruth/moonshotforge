---
import { projects } from '../data';
---

<section id="portfolio" class="relative z-[1] bg-forge-dim px-5 py-20 sm:px-8 sm:py-24 lg:px-[60px] lg:py-[120px]">
  <!-- Header -->
  <div class="fade-up flex flex-col gap-5 mb-14 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <div class="section-label">03 · Portfolio</div>
      <h2 class="font-syne font-bold tracking-[-0.02em] leading-[1.05]
                 text-[30px] sm:text-[38px] lg:text-[48px] xl:text-[54px]">
        Selected<br/>Ventures
      </h2>
    </div>
    <a href="#apply"
       class="self-start sm:self-end font-mono text-[11px] tracking-wider2 uppercase
              text-forge-cream border border-subtle px-6 py-3 no-underline
              transition-all duration-200 hover:border-forge-accent hover:text-forge-accent">
      Join Portfolio →
    </a>
  </div>

  <!-- Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[2px]">
    {projects.map((p, i) => (
      <button
        class="project-card card-glow relative bg-forge-black border border-subtle
               text-left p-8 sm:p-9 overflow-hidden
               transition-all duration-300 hover:border-[rgba(232,213,163,0.22)]
               fade-up cursor-pointer w-full"
        style={`transition-delay: ${i * 0.08}s`}
        data-project={i}
        aria-label={`View ${p.name} details`}
      >
        <span class="inline-block text-[9px] tracking-wider3 uppercase text-forge-accent
                     border border-[rgba(232,213,163,0.3)] px-[9px] py-1 mb-5">
          {p.tag}
        </span>
        <div class="font-syne font-bold text-[21px] mb-2 tracking-[-0.01em]">{p.name}</div>
        <p class="text-[11px] leading-[1.8] text-[rgba(200,195,184,0.55)] mb-7">{p.desc}</p>
        <div class="flex justify-between items-center border-t border-subtle pt-4">
          <span class="text-[10px] tracking-wider2 uppercase text-[rgba(200,195,184,0.35)]">{p.chain}</span>
          <span class="text-[16px] text-forge-accent transition-transform duration-200 project-arrow">↗</span>
        </div>
      </button>
    ))}
  </div>
</section>

<style>
  .section-label {
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #e8d5a3;
    margin-bottom: 48px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .section-label::after {
    content: '';
    flex: 1;
    max-width: 60px;
    height: 1px;
    background: var(--border);
  }
  .project-card:hover .project-arrow {
    transform: translate(4px, -4px);
  }
</style>
