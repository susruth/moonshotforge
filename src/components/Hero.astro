---
---

<section
  id="hero"
  class="relative z-[1] min-h-screen flex flex-col justify-end overflow-hidden
         px-5 pb-16 pt-24
         sm:px-8 sm:pb-20
         lg:px-[60px] lg:pb-24"
>
  <!-- Background radial glow -->
  <div
    class="absolute -top-48 -right-72 w-[900px] h-[900px] rounded-full pointer-events-none"
    style="background: radial-gradient(circle, rgba(196,96,26,0.06) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <!-- Tag -->
  <div class="hero-tag-anim flex items-center gap-3 mb-7 text-forge-accent text-[11px] tracking-wider3 uppercase">
    <span class="block w-9 h-px bg-forge-accent shrink-0" aria-hidden="true"></span>
    Web3 Venture Studio · Est. 2024
  </div>

  <!-- H1 -->
  <h1 class="hero-h1-anim font-syne font-extrabold uppercase tracking-[-0.02em] leading-[0.9]
             text-[60px]
             sm:text-[80px]
             md:text-[100px]
             lg:text-[130px]
             xl:text-[138px]
             max-w-[900px]">
    Building The
    <em class="not-italic block"
        style="color: transparent; -webkit-text-stroke: 1px rgba(240,237,230,0.35);">
      Next
    </em>
    Frontier
  </h1>

  <!-- Sub row -->
  <div class="hero-sub-anim flex flex-col gap-8 mt-12
              sm:flex-row sm:items-end sm:justify-between sm:gap-10">
    <p class="text-[13px] leading-[1.8] text-forge-cream max-w-[360px]">
      We co-found, fund, and forge the infrastructure protocols and applications
      that will define the decentralized economy.
    </p>
    <div class="flex flex-col gap-3 w-full sm:flex-row sm:w-auto sm:shrink-0">
      <a href="#portfolio"
         class="inline-block text-center font-mono text-[11px] tracking-wider2 uppercase
                text-forge-black bg-forge-accent px-7 py-[13px]
                border border-forge-accent transition-all duration-200
                hover:bg-transparent hover:text-forge-accent">
        View Portfolio
      </a>
      <a href="#process"
         class="inline-block text-center font-mono text-[11px] tracking-wider2 uppercase
                text-forge-cream bg-transparent px-7 py-[13px]
                border border-subtle transition-all duration-200
                hover:border-forge-accent hover:text-forge-accent">
        Our Model
      </a>
    </div>
  </div>
</section>
